#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        Tab {
            bindings = <&kp TAB>;
            key-positions = <2 3>;
        };

        Super {
            bindings = <&kp LEFT_META>;
            key-positions = <26 27>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <27 28>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <25 26>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC           &kp B  &kp L  &kp D         &kp W  &kp Z          &kp SEMICOLON  &kp F  &kp O          &kp U       &kp J         &kp BACKSPACE
&kp LEFT_SHIFT    &kp N  &kp R  &kp T         &kp S  &kp G          &kp Y          &kp H  &kp A          &kp E       &kp I         &mt RIGHT_SHIFT SINGLE_QUOTE
&kp LEFT_CONTROL  &kp Q  &kp X  &kp M         &kp C  &kp V          &kp K          &kp P  &kp COMMA      &kp PERIOD  &kp QUESTION  &kp DELETE
                                &kp LEFT_ALT  &mo 1  &lt 3 SPACE    &kp ENTER      &mo 2  &kp RIGHT_ALT
            >;
        };

        KEYPAD {
            bindings = <
&trans  &kp KP_MULTIPLY  &kp KP_N7        &kp KP_N8  &kp KP_N9  &kp KP_PLUS        &trans    &trans          &kp UP_ARROW    &trans           &trans   &trans
&trans  &kp KP_DIVIDE    &kp KP_NUMBER_4  &kp KP_N5  &kp KP_N6  &kp KP_SUBTRACT    &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans
&trans  &kp KP_N0        &kp KP_N1        &kp KP_N2  &kp KP_N3  &kp KP_DOT         &trans    &trans          &trans          &trans           &trans   &trans
                                          &trans     &trans     &trans             &trans    &trans          &trans
            >;

            label = "Keypad";
        };

        SYMBOLS {
            bindings = <
&trans  &kp EXCL  &kp AT  &kp POUND  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans    &trans  &trans     &trans      &trans         &kp MINUS  &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SLASH              &kp GRAVE
&trans  &trans    &trans  &trans     &trans      &trans         &trans     &trans         &trans            &trans                &trans                 &trans
                          &trans     &trans      &trans         &trans     &trans         &trans
            >;

            label = "Symbols";
        };

        layer_3 {
            bindings = <
&trans  &trans  &kp F7  &kp F8  &kp F9  &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F4  &kp F5  &kp F4  &kp F12    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F11    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans     &trans  &trans  &trans
            >;
        };
    };
};
